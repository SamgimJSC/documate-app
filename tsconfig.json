{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "utils/**/*.ts",
    "types/**/*.ts",
    "types/**/*.tsx",
    "expo-env.d.ts",
    "styles/**/*.ts",
    ".expo/types/**/*.ts",
    "types/env.d.ts"
  ],
  "exclude": ["node_modules", ".expo", "dist", "build"]
}
